<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <TextView
        android:id="@+id/download_title"
        style="@style/Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/tab_downloads"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/download_tabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="@dimen/space_l"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/download_title"
        app:tabGravity="start"
        app:tabIndicatorColor="@color/text"
            app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="2dp"
        app:tabMode="scrollable"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="@color/text"
        app:tabTextColor="@color/text_faint" />


    <!-- 批量操作条：进入多选才显示，GONE 时列表自动上移 -->
    <LinearLayout
        android:id="@+id/batch_bar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_batch_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_l"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/download_tabs">

        <TextView
            android:id="@+id/batch_count"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/batch_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:paddingHorizontal="@dimen/space_s"
            android:paddingVertical="@dimen/space_xs"
            android:text="@string/batch_all"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/batch_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:paddingHorizontal="@dimen/space_s"
            android:paddingVertical="@dimen/space_xs"
            android:text="@string/batch_pause"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/batch_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:paddingHorizontal="@dimen/space_s"
            android:paddingVertical="@dimen/space_xs"
            android:text="@string/batch_delete"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/batch_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:letterSpacing="0.06"
            android:paddingHorizontal="@dimen/space_s"
            android:paddingVertical="@dimen/space_xs"
            android:text="@string/batch_cancel"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/download_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_xl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/batch_bar" />

    <TextView
        android:id="@+id/download_empty"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:text="@string/empty_downloads_active"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/download_tabs" />

</androidx.constraintlayout.widget.ConstraintLayout>
