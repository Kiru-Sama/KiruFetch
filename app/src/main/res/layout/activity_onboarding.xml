<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:paddingHorizontal="@dimen/space_xl">

    <TextView
        android:id="@+id/onboard_skip"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:letterSpacing="0.08"
        android:padding="@dimen/space_s"
        android:text="@string/onboard_skip"
        android:textColor="@color/text_faint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/onboard_step"
        style="@style/Text.Kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/onboard_title"
        style="@style/Text.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:lineSpacingExtra="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/onboard_step" />

    <View
        android:id="@+id/onboard_rule"
        android:layout_width="48dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/space_l"
        android:background="@color/text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/onboard_title" />

    <TextView
        android:id="@+id/onboard_body"
        style="@style/Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:lineSpacingExtra="8dp"
        android:textColor="@color/text_dim"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/onboard_rule" />

    <LinearLayout
        android:id="@+id/onboard_group_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="@dimen/space_l"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/onboard_body">

        <TextView
            style="@style/Text.Kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboard_group_label" />

        <TextView
            android:id="@+id/onboard_group_number"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.1"
            android:text="@string/feedback_group_number"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/onboard_group_hint"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/onboard_group_hint"
            android:textColor="@color/text_faint" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/onboard_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xl"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/onboard_next"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/onboard_next"
        style="@style/Text.Body"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/bg_pill_accent"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:text="@string/onboard_next"
        android:textColor="@color/bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
